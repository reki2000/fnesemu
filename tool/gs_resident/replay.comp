#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std430) buffer LocalMemory { uint vram[]; };
layout(set = 0, binding = 1, std430) readonly buffer DrawSnapshot { uint snapshot[]; };
layout(set = 0, binding = 2, std430) readonly buffer Commands { uint commands[]; };
layout(set = 0, binding = 3, std430) readonly buffer Auxiliary { uint aux[]; };
layout(set = 0, binding = 4, std430) writeonly buffer Scanout { uint output_pixels[]; };
layout(set = 0, binding = 5, std430) readonly buffer TileBins { uint tile_masks[]; };
layout(push_constant) uniform Push {
  uint command_index, draw_count, left, top, tile_offset;
} push;
uint active_command;
bool disjoint_surfaces;

struct SpriteInfo {
  vec4 sizes;
  vec4 depth;
  vec4 color;
  vec4 texture_mode;
  vec4 blend;
  vec4 tests;
  vec4 writes;
  vec4 tex_geometry;
  vec4 geometry_mode;
  vec4 pos_a;
  vec4 uv_a;
  vec4 col_a;
  vec4 pos_b;
  vec4 uv_b;
  vec4 col_b;
  vec4 pos_c;
  vec4 uv_c;
  vec4 col_c;
  vec4 tex_bounds;
  vec4 fog;
  vec4 sprite_uv;
  vec4 frame_options;
  vec4 dither0;
  vec4 dither1;
  vec4 dither2;
  vec4 dither3;
  vec4 mip;
  vec4 mip_filter;
};
SpriteInfo info;

uint word(int offset) {
  return commands[active_command * 160u + uint(offset)];
}
vec4 floats(int offset) {
  return uintBitsToFloat(uvec4(word(offset), word(offset + 1), word(offset + 2), word(offset + 3)));
}

uint mask_for(uint psm) {
  if (psm == 0u || psm == 48u) return 0xffffffffu;
  if (psm == 1u || psm == 49u) return 0xffffffu;
  if (psm == 2u || psm == 10u || psm == 50u || psm == 58u) return 0xffffu;
  if (psm == 19u || psm == 27u) return 255u;
  return 15u;
}

// Return the wrapped word address, shift and unshifted pixel mask.
uvec3 gs_address(uint psm, uint base, uint pages, uvec2 xy) {
  uint layout_offset = psm * 4u;
  uint table = aux[layout_offset];
  uint xb = aux[layout_offset + 1u], yb = aux[layout_offset + 2u];
  uint units = aux[layout_offset + 3u];
  uint page = (xy.y >> yb) * pages + (xy.x >> xb);
  uint local_index = ((xy.y & ((1u << yb) - 1u)) << xb) | (xy.x & ((1u << xb) - 1u));
  uint index = ((base * 64u + page * 2048u) << units) + aux[table + local_index];
  uint shift = (index & ((1u << units) - 1u)) * (32u >> units);
  if (psm == 27u || psm == 36u) shift = 24u;
  if (psm == 44u) shift = 28u;
  return uvec3((index >> units) & 0xfffffu, shift, mask_for(psm));
}

uint read_value(uvec3 address, bool from_snapshot, bool exclusive) {
  uint value = from_snapshot ? snapshot[address.x] :
      exclusive ? vram[address.x] : atomicOr(vram[address.x], 0u);
  return (value >> address.y) & address.z;
}

void store_value(uvec3 address, uint value, uint preserve, bool exclusive) {
  uint bits = address.z & ~preserve;
  if (bits == 0u) return;
  uint mask = bits << address.y;
  uint packed = (value & bits) << address.y;
  if (mask == 0xffffffffu) {
    vram[address.x] = packed;
  } else if (exclusive) {
    vram[address.x] = (vram[address.x] & ~mask) | packed;
  } else {
    uint old = atomicOr(vram[address.x], 0u);
    for (;;) {
      uint observed = atomicCompSwap(vram[address.x], old, (old & ~mask) | packed);
      if (observed == old) break;
      old = observed;
    }
  }
}

uint pack_color(uvec4 color) {
  return color.r | color.g << 8 | color.b << 16 | color.a << 24;
}

vec4 decode_color(uint raw, uint psm, bool frame) {
  uint format = psm >= 48u ? psm & 15u : psm;
  if (format == 0u) return vec4(raw & 255u, raw >> 8 & 255u, raw >> 16 & 255u, raw >> 24);
  if (format == 1u) {
    uint alpha = frame ? 128u : word(129);
    if (!frame && word(131) != 0u && raw == 0u) alpha = 0u;
    return vec4(raw & 255u, raw >> 8 & 255u, raw >> 16 & 255u, alpha);
  }
  uint alpha = frame ? 128u : word(130);
  if ((raw & 0x8000u) == 0u) alpha = frame ? 0u : word(129);
  if (!frame && word(131) != 0u && (raw & 0x7fffu) == 0u) alpha = 0u;
  return vec4((raw & 31u) << 3, (raw >> 5 & 31u) << 3, (raw >> 10 & 31u) << 3, alpha);
}

vec4 texel_at(vec2 uv, int level) {
  uint psm = word(124);
  uint base = level == 0 ? word(125) : word(133 + (level - 1) * 2);
  uint pages = level == 0 ? word(126) : word(134 + (level - 1) * 2);
  uvec3 address = gs_address(psm, base, pages, uvec2(uv));
  uint value = read_value(address, address.x >= word(149) && address.x < word(150),
      disjoint_surfaces);
  if (psm == 19u || psm == 20u || psm == 27u || psm == 36u || psm == 44u) {
    value = vram[1048576u + ((word(128) + value) & 511u)];
    psm = word(127);
  }
  return decode_color(value, psm, false);
}

bool alpha_passes(float a, float test, float ref_value) {
  if (test == 0.0) return false;
  if (test == 1.0) return true;
  if (test == 2.0) return a < ref_value;
  if (test == 3.0) return a <= ref_value;
  if (test == 4.0) return a == ref_value;
  if (test == 5.0) return a >= ref_value;
  if (test == 6.0) return a > ref_value;
  return a != ref_value;
}

vec3 color_term(float mode, vec3 src, vec3 dst) {
  return mode == 0.0 ? src : (mode == 1.0 ? dst : vec3(0.0));
}

float edge(vec2 a, vec2 b, vec2 p) {
  vec2 d = b - a, q = p - a;
  return d.x * q.y - d.y * q.x;
}

bool covered(float e, vec2 d, float orientation) {
  vec2 side = d * orientation;
  return e * orientation > 0.0 ||
      (e == 0.0 && (side.y < 0.0 || (side.y == 0.0 && side.x > 0.0)));
}

float region_repeat(float coordinate, float mask, float fix) {
  float result = 0.0;
  float bit = 1.0;
  for (int i = 0; i < 10; i++) {
    float c = mod(floor(coordinate / bit), 2.0);
    float m = mod(floor(mask / bit), 2.0);
    float f = mod(floor(fix / bit), 2.0);
    result += max(c * m, f) * bit;
    bit *= 2.0;
  }
  return result;
}

vec2 wrap_uv(vec2 uv, float scale) {
  vec2 size = max(floor(info.tex_geometry.xy * scale), 1.0);
  vec2 mode = vec2(mod(info.tex_geometry.z, 4.0), floor(info.tex_geometry.z / 4.0));
  vec2 lo = mix(vec2(0.0), floor(info.tex_bounds.xy * scale), step(vec2(2.0), mode));
  vec2 hi = mix(size - 1.0, floor(info.tex_bounds.zw * scale), step(vec2(2.0), mode));
  vec2 region = mix(lo, min(uv, hi), step(lo, uv));
  vec2 result = mix(mod(uv, size), region, step(vec2(1.0), mode));
  if (mode.x == 3.0) result.x = region_repeat(uv.x, info.tex_bounds.x, info.tex_bounds.z);
  if (mode.y == 3.0) result.y = region_repeat(uv.y, info.tex_bounds.y, info.tex_bounds.w);
  return result;
}

vec4 sample_level(vec2 uv, float level, bool linear) {
  float scale = exp2(-level);
  uv *= scale;
  if (!linear) return texel_at(wrap_uv(floor(uv), scale), int(level));
  vec2 base = floor(uv - 0.5);
  vec2 f = uv - 0.5 - base;
  vec4 c00 = texel_at(wrap_uv(base, scale), int(level));
  vec4 c10 = texel_at(wrap_uv(base + vec2(1.0, 0.0), scale), int(level));
  vec4 c01 = texel_at(wrap_uv(base + vec2(0.0, 1.0), scale), int(level));
  vec4 c11 = texel_at(wrap_uv(base + 1.0, scale), int(level));
  return floor(mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y) + 0.5);
}

vec4 sample_texture(vec2 uv, float q) {
  float lod = info.mip.z;
  if (info.mip.x != 0.0 && info.mip.y != 0.0 && q != 0.0) {
    lod -= log2(abs(q)) * info.mip.y;
  }
  if (info.mip.x == 0.0 || lod <= 0.0) {
    return sample_level(uv, 0.0, info.tex_geometry.w != 0.0);
  }
  float filter_mode = info.mip_filter.x;
  bool linear = filter_mode == 1.0 || filter_mode >= 4.0;
  float top = min(lod, info.mip.w);
  if (filter_mode != 3.0 && filter_mode != 5.0) {
    return sample_level(uv, floor(top + 0.5), linear);
  }
  float level = floor(top);
  float frac = top - level;
  vec4 c0 = sample_level(uv, level, linear);
  if (frac == 0.0 || level >= info.mip.w) return c0;
  return floor(mix(c0, sample_level(uv, level + 1.0, linear), frac) + 0.5);
}

void render_pixel(uvec2 pixel) {
  uvec2 gs_xy = pixel + uvec2(word(112), word(113));
  vec2 p = vec2(pixel);
  disjoint_surfaces = word(151) != 0u || push.draw_count > 1u;
  info.depth = floats(4);
  info.writes = floats(24);
  float ztest = info.depth.y;
  float zlow = info.depth.z, zhigh = info.depth.w;
  if (ztest == 0.0) return;
  bool triangle = info.writes.w != 0.0;
  vec3 w = vec3(0.0);
  if (triangle) {
    info.geometry_mode = floats(32);
    info.pos_a = floats(36);
    info.pos_b = floats(48);
    info.pos_c = floats(60);
    vec2 a = info.pos_a.xy, b = info.pos_b.xy, c = info.pos_c.xy;
    float area = edge(a, b, c);
    if (area == 0.0) return;
    float orientation = sign(area);
    vec2 sample_point = p * 16.0;
    float ea = edge(b, c, sample_point);
    float eb = edge(c, a, sample_point);
    float ec = edge(a, b, sample_point);
    if (!covered(ea, c - b, orientation) ||
        !covered(eb, a - c, orientation) ||
        !covered(ec, b - a, orientation)) return;
    w = vec3(ea, eb, ec) / area;
    float za = info.pos_a.z;
    float delta = w.y * (info.pos_b.z - za) + w.z * (info.pos_c.z - za);
    float z = clamp(za + floor(delta + 0.5), 0.0, info.geometry_mode.z);
    zhigh = floor(z / 65536.0);
    zlow = z - zhigh * 65536.0;
  }
  uvec3 depth_address = uvec3(0u);
  if (ztest >= 2.0 || info.writes.z != 0.0) {
    depth_address = gs_address(word(121), word(122), word(123), gs_xy);
  }
  bool exclusive_depth = disjoint_surfaces && depth_address.z >= 0xffffffu;
  uint z = uint(zlow) | uint(zhigh) << 16;
  if (ztest >= 2.0) {
    uint old_z = read_value(depth_address, false, exclusive_depth);
    if (z < old_z || (z == old_z && ztest == 3.0)) return;
  }

  info.texture_mode = floats(12);
  info.uv_b = floats(52);
  info.fog = floats(76);
  vec4 vertex = floats(8);
  float fog = info.uv_b.z;
  if (triangle) {
    info.col_c = floats(68);
    if (info.geometry_mode.y != 0.0) {
      info.col_a = floats(44);
      info.col_b = floats(56);
      vertex = floor(info.col_a * w.x + info.col_b * w.y + info.col_c * w.z + 0.5);
    } else {
      vertex = info.col_c;
    }
    if (info.fog.w != 0.0) {
      info.uv_a = floats(40);
      info.uv_c = floats(64);
      fog = floor(dot(w, vec3(info.uv_a.z, info.uv_b.z, info.uv_c.z)) + 0.5);
    }
  }

  float mode = info.texture_mode.x;
  vec4 texel = vertex;
  if (mode >= 0.0) {
    info.tex_geometry = floats(28);
    info.tex_bounds = floats(72);
    info.uv_a = floats(40);
    if (triangle) {
      info.uv_c = floats(64);
      info.mip = floats(104);
      info.mip_filter = floats(108);
      vec2 uv = info.uv_a.xy * w.x + info.uv_b.xy * w.y + info.uv_c.xy * w.z;
      float lod_q = 1.0;
      if (info.geometry_mode.x == 0.0) {
        lod_q = dot(w, vec3(info.pos_a.w, info.pos_b.w, info.pos_c.w));
        float q = lod_q == 0.0 ? 1.0 : lod_q;
        uv = clamp(uv / q * info.tex_geometry.xy, -32768.0, 32768.0);
      }
      texel = sample_texture(uv, lod_q);
    } else {
      info.sprite_uv = floats(80);
      vec2 weight = (p * 16.0 + info.sprite_uv.zw) / info.sprite_uv.xy;
      vec2 uv = info.uv_a.xy + (info.uv_b.xy - info.uv_a.xy) * weight;
      texel = sample_level(uv, 0.0, info.tex_geometry.w != 0.0);
    }
  }
  vec4 src = texel;
  if (mode >= 0.0 && mode != 1.0) {
    src = floor(texel * vertex / 128.0);
    if (mode >= 2.0) {
      src.rgb += vertex.a;
      src.a = texel.a + (mode == 2.0 ? vertex.a : 0.0);
    }
    src = min(src, vec4(255.0));
  }
  if (info.texture_mode.y == 0.0) src.a = vertex.a;

  if (info.fog.w != 0.0) src.rgb = floor((fog * src.rgb + (255.0 - fog) * info.fog.xyz) / 256.0);

  uint frame_psm = word(116);
  uvec3 frame_address = gs_address(frame_psm, word(117), word(118), gs_xy);
  bool exclusive_frame = disjoint_surfaces && frame_address.z >= 0xffffffu;
  float date = info.writes.y;
  bool blend_color = info.texture_mode.z != 0.0 &&
      (info.texture_mode.w == 0.0 || src.a >= 128.0);
  vec4 dst = vec4(0.0);
  if (date != 0.0 || blend_color) {
    dst = decode_color(read_value(frame_address, false, exclusive_frame), frame_psm, true);
  }
  if (date != 0.0 && floor(dst.a / 128.0) != date - 1.0) return;
  info.tests = floats(20);
  float write_color = 1.0, write_z = info.writes.z;
  if (!alpha_passes(src.a, info.tests.z, info.tests.w)) {
    float fail = info.writes.x;
    if (fail == 0.0) return;
    if (fail == 2.0) write_color = 0.0;
    if (fail != 2.0) write_z = 0.0;
    if (fail == 3.0) write_color = 2.0;
  }
  if (write_z != 0.0) store_value(depth_address, z, 0u, exclusive_depth);
  if (write_color == 0.0) return;
  if (blend_color) {
    vec4 blend = floats(16);
    float factor = blend.z == 0.0 ? src.a : (blend.z == 1.0 ? dst.a : info.tests.x);
    vec3 a = color_term(blend.x, src.rgb, dst.rgb);
    vec3 b = color_term(blend.y, src.rgb, dst.rgb);
    vec3 d = color_term(blend.w, src.rgb, dst.rgb);
    src.rgb = floor((a - b) * factor / 128.0) + d;
    src.rgb = info.tests.y != 0.0 ? clamp(src.rgb, 0.0, 255.0) : mod(src.rgb, 256.0);
  }
  info.frame_options = floats(84);
  if (info.frame_options.z != 0.0) {
    info.dither0 = floats(88);
    info.dither1 = floats(92);
    info.dither2 = floats(96);
    info.dither3 = floats(100);
    vec2 d = mod(p + info.frame_options.xy, 4.0);
    vec4 row = d.y == 0.0 ? info.dither0 : (d.y == 1.0 ? info.dither1 : (d.y == 2.0 ? info.dither2 : info.dither3));
    float delta = d.x == 0.0 ? row.x : (d.x == 1.0 ? row.y : (d.x == 2.0 ? row.z : row.w));
    src.rgb += delta;
    src.rgb = info.tests.y != 0.0 ? clamp(src.rgb, 0.0, 255.0) : mod(src.rgb, 256.0);
  }
  uvec4 rgba = uvec4(src);
  if (word(120) != 0u) rgba.a |= 128u;
  bool short_color = (frame_psm & 15u) == 2u || (frame_psm & 15u) == 10u;
  uint value = short_color
      ? (rgba.r >> 3) | ((rgba.g >> 3) << 5) | ((rgba.b >> 3) << 10) | ((rgba.a >> 7) << 15)
      : pack_color(rgba);
  uint mask = word(119);
  if (write_color == 2.0) mask |= short_color ? 0x8000u : 0xff000000u;
  store_value(frame_address, value, mask, exclusive_frame);
}

void main() {
  active_command = push.command_index;
  uvec2 pixel = gl_GlobalInvocationID.xy;
  uint operation = word(146);
  if (operation == 1u || operation == 2u) {
    uint index = pixel.x + pixel.y * gl_NumWorkGroups.x * 8u;
    if (index >= word(148)) return;
    uint start = word(147);
    if (operation == 1u) {
      uint bits = word(149), width = word(114);
      uint bit = index * bits, shift = bit & 31u;
      uint at = start + (bit >> 5);
      uint value = aux[at] >> shift;
      if (shift + bits > 32u) value |= aux[at + 1u] << (32u - shift);
      uvec2 xy = uvec2(word(112) + index % width, word(113) + index / width);
      store_value(gs_address(word(116), word(117), word(118), xy), value, 0u,
          bits >= 24u);
    } else {
      uint at = start + index * 4u;
      vram[1048576u + aux[at]] = (vram[aux[at + 1u]] >> aux[at + 2u]) & aux[at + 3u];
    }
    return;
  }
  if (push.draw_count > 1u) {
    uvec2 xy = pixel + uvec2(push.left, push.top);
    uint mask;
    if (push.tile_offset == 0xffffffffu) {
      mask = push.draw_count == 32u ? 0xffffffffu : (1u << push.draw_count) - 1u;
    } else {
      uint tile = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
      mask = tile_masks[push.tile_offset + tile];
    }
    while (mask != 0u) {
      uint i = uint(findLSB(mask));
      mask &= mask - 1u;
      active_command = push.command_index + i;
      uvec2 local = xy - uvec2(word(112), word(113));
      if (local.x < word(114) && local.y < word(148)) render_pixel(local);
    }
    return;
  }
  uint width = word(114), height = word(115);
  if (pixel.x >= width) return;
  if (operation == 3u) {
    if (pixel.y >= height) return;
    uint raw = read_value(gs_address(word(116), word(117), word(118),
        uvec2(word(112) + pixel.x, word(113) + pixel.y / 2u)), false, true);
    output_pixels[pixel.y * width + pixel.x] = pack_color(
        uvec4(decode_color(raw, word(116), true).rgb, 255u));
    return;
  }
  pixel.y += word(147);
  if (pixel.y >= word(148)) return;
  render_pixel(pixel);
}
